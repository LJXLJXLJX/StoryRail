# 复制为 start.local.env（Git 忽略）后按本机部署填写；start.sh 启动时读取。
# 只在存在 var/secrets/windows-model-service-token 时接入 Windows 默认模型服务。

# Windows 模型服务地址（LAN 地址 + 端口）。
STORYRAIL_WINDOWS_RUNTIME_ENDPOINT=http://<windows-lan-ip>:8791
# 启动时经 SSH 重启 Windows 服务；不需要时设为 0，并可省略下面三项。
STORYRAIL_AUTOSTART_WINDOWS_PROVIDER=1
STORYRAIL_WINDOWS_SSH_TARGET=<ssh-alias>
STORYRAIL_WINDOWS_REPOSITORY_ROOT='<drive>:\path\to\StoryRail'
STORYRAIL_WINDOWS_LISTEN_ADDRESS=<windows-lan-ip>
