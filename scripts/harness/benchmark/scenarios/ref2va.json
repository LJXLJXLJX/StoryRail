{
  "scenario": "ref2va",
  "capability": "video_prompt",
  "bootstrap": "keyframes",
  "summary": "关键帧已选且 Segment 为 Ref2VA：读契约 → 读工作集 → 显式加入本段已选对白并保存提示词 → 生成 → wait。",
  "steps": [
    {
      "id": "tools",
      "action": "list_tools"
    },
    {
      "id": "workflow",
      "action": "call",
      "tool": "read_workflow",
      "arguments": {
        "project_id": "$base.project_id",
        "expected_revision": "$base.expected_revision",
        "idempotency_key": "bench-ref2va-workflow"
      }
    },
    {
      "id": "contract",
      "action": "pages",
      "tool": "read_professional_contract",
      "arguments": {
        "project_id": "$base.project_id",
        "expected_revision": "$base.expected_revision",
        "idempotency_key": "bench-ref2va-contract",
        "capability": "video_prompt",
        "page_bytes": 24576
      }
    },
    {
      "id": "workset",
      "action": "pages",
      "tool": "read_professional_workset",
      "arguments": {
        "project_id": "$base.project_id",
        "expected_revision": "$base.expected_revision",
        "idempotency_key": "bench-ref2va-workset",
        "capability": "video_prompt",
        "scene_ids": "$base.scene_ids",
        "target_ids": "$base.segment_ids",
        "page_bytes": 24576
      },
      "assert": {
        "no_error": true
      },
      "capture": "video_workset"
    },
    {
      "id": "mode",
      "action": "call",
      "tool": "set_video_recipe",
      "arguments": {
        "project_id": "$base.project_id",
        "expected_revision": "$base.expected_revision",
        "idempotency_key": "bench-ref2va-mode",
        "scene_ids": "$base.scene_ids",
        "segment_id": "$base.segment_id",
        "recipe_id": "minimax_h3.ref2va"
      },
      "assert": {
        "no_error": true
      }
    },
    {
      "id": "prompt",
      "action": "call",
      "tool": "save_video_prompt",
      "arguments": {
        "project_id": "$base.project_id",
        "expected_revision": "$mode.receipt.new_revision",
        "idempotency_key": "bench-ref2va-prompt",
        "scene_ids": "$base.scene_ids",
        "segment_id": "$base.segment_id",
        "prompt_text": "保持角色身份与对白口型，固定机位观察站台，冷蓝色天光。",
        "recipe_inputs": {
          "bindings": {
            "reference_audios": "$video_workset.core_facts.dialogue_audio.bindings"
          },
          "params": {}
        }
      },
      "assert": {
        "no_error": true
      }
    },
    {
      "id": "generate",
      "action": "call",
      "tool": "generate_media",
      "arguments": {
        "project_id": "$base.project_id",
        "expected_revision": "$prompt.receipt.new_revision",
        "idempotency_key": "bench-ref2va-generate",
        "kind": "video",
        "target_id": "$base.segment_id"
      }
    },
    {
      "id": "wait",
      "action": "wait",
      "tool": "manage_generation",
      "arguments": {
        "project_id": "$base.project_id",
        "expected_revision": "$generate.receipt.new_revision",
        "idempotency_key": "bench-ref2va-wait",
        "action": "wait",
        "generation_ids": "$generate.data.generation_ids"
      }
    }
  ]
}
